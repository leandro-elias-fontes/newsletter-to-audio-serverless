# Google AI Studio (2 chaves gratuitas em rotação)
GEMINI_API_KEY_1=sua_chave_gemini_1
GEMINI_API_KEY_2=sua_chave_gemini_2
GEMINI_MODEL=gemini-2.5-flash

# Gmail API OAuth2 (gerado pelo scripts/auth_gmail.py)
GMAIL_CLIENT_ID=seu_client_id
GMAIL_CLIENT_SECRET=seu_client_secret
GMAIL_REFRESH_TOKEN=seu_refresh_token
GMAIL_QUERY=is:unread newer_than:1d
MAX_EMAILS_PER_RUN=15

# Telegram Bot
TELEGRAM_BOT_TOKEN=seu_bot_token
TELEGRAM_CHAT_ID=seu_chat_id

# Áudio (edge-tts)
TTS_VOICE=pt-BR-AntonioNeural
TTS_RATE=+5%

# Cache local SQLite para desenvolvimento (evita gasto repetido de tokens)
ENABLE_LOCAL_CACHE=true
CACHE_DB_PATH=.cache_gemini.sqlite
